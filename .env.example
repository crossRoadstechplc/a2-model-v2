# A2 Simulator Gateway – Frontend environment variables
# Copy to .env or .env.local and adjust as needed.

# API base URL (no trailing slash). Default: http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000

# Admin analytics password. CTRL+Shift+A opens password dialog; correct password shows analytics.
# No spaces around = (e.g. VITE_ADMIN_PASS=yourpassword)
# VITE_ADMIN_PASS=yourpassword
